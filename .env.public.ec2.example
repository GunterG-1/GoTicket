# Private IPv4 address of this EC2 instance. Backend ports must be restricted
# in the EC2 security group so only this instance/security group can reach them.
BACKEND_HOST=replace-with-ec2-private-ip
GOTICKET_INTERNAL_API_TOKEN=replace-with-the-same-random-shared-token-as-env-backend

OAUTH2_CLIENT_ID=replace-with-google-client-id
OAUTH2_CLIENT_SECRET=replace-with-google-client-secret
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Use the public HTTPS origin when TLS is configured; otherwise use http://<public-ip>.
FRONTEND_OAUTH_SUCCESS_URL=https://replace-with-public-domain/#oauth2
CORS_ALLOWED_ORIGINS=https://replace-with-public-domain
