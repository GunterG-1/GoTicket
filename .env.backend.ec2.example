# External MySQL (for example, an RDS endpoint). Create the goticket_* databases first.
MYSQL_HOST=replace-with-rds-endpoint
MYSQL_PORT=3306
MYSQL_USER=goticket_app
MYSQL_PASSWORD=replace-with-database-password

# Generate a long random value and use the exact same value in .env.public.
GOTICKET_INTERNAL_API_TOKEN=replace-with-a-long-random-shared-token

REDIS_HOST=redis
REDIS_PORT=6379

# Use the EC2 instance profile for AWS credentials; do not set static access keys here.
AWS_REGION=us-east-1
AWS_ENDPOINT=
GOTICKET_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:replace-with-account-id:goticket-events
GOTICKET_ORDEN_PAYMENT_APPROVED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/replace-with-account-id/orden-pago-aprobado
GOTICKET_ORDEN_PAYMENT_FAILED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/replace-with-account-id/orden-pago-fallido
GOTICKET_INVENTARIO_ORDER_CREATED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/replace-with-account-id/inventario-orden-creada
GOTICKET_INVENTARIO_PAYMENT_APPROVED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/replace-with-account-id/inventario-pago-aprobado
GOTICKET_INVENTARIO_PAYMENT_FAILED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/replace-with-account-id/inventario-pago-fallido
GOTICKET_PAGOS_ORDER_CREATED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/replace-with-account-id/pagos-orden-creada
GOTICKET_PAGOS_PAYMENT_FAILED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/replace-with-account-id/pagos-pago-fallido
GOTICKET_AWS_POLL_MS=1000

# Configure a real SMTP provider if ticket email delivery is required.
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=noreply@example.com
GOTICKET_MAIL_RETRY_MS=60000

